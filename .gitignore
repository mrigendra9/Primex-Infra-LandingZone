# ============================================================
# Terraform
# ============================================================

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files - may contain secrets
*.tfvars
*.tfvars.json

# Exception: commit example variable files
!*.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
*.plan

# Terraform lock file
# Keep this file in Git for provider version consistency
# .terraform.lock.hcl


# ============================================================
# Secrets / Credentials
# ============================================================

# Environment files
.env
.env.*
!.env.example

# Azure credentials
azure_credentials.json
azure-credentials.json

# Service Principal / certificate files
*.pem
*.key
*.pfx
*.p12
*.crt

# SSH private keys
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk


# ============================================================
# Azure CLI / Authentication
# ============================================================

.azure/
.azureclirc

# Azure CLI token/cache
.azure/
.azure-accessTokens.json


# ============================================================
# Logs
# ============================================================

*.log
logs/
log/


# ============================================================
# OS Generated Files
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.nfs*


# ============================================================
# IDE / Editors
# ============================================================

# Visual Studio Code
.vscode/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo

# IntelliJ / JetBrains
.idea/
*.iml


# ============================================================
# Temporary Files
# ============================================================

*.tmp
*.temp
*.bak
*.swp
*.swo

# Terraform generated files
terraform.tfstate.d/


# ============================================================
# Python (if used for automation/scripts)
# ============================================================

__pycache__/
*.py[cod]
*.pyo

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/


# ============================================================
# Build / Distribution
# ============================================================

dist/
build/
*.egg-info/


# ============================================================
# Local Development Files
# ============================================================

*.local
local/
tmp/
temp/